# Upstream routing is configured in upstreams.yaml (model-name pattern → base_url).
UPSTREAM_ROUTES_FILE=./upstreams.yaml
# Required only if upstreams.yaml has a route with api_key_env: DATABRICKS_TOKEN
DATABRICKS_TOKEN=
PROXY_PORT=8888
DB_PATH=./data/claude-proxy.db
OTEL_ENDPOINT=http://localhost:4318
PROXY_SSL_VERIFY=true
LOG_LEVEL=INFO
